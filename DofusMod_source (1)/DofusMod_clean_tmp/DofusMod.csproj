<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DofusMod</AssemblyName>
    <RootNamespace>DofusMod</RootNamespace>
    <LangVersion>9</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Stops the SDK from emitting a reference assembly -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 core + analyzers -->
    <PackageReference Include="BepInEx.Analyzers"           Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core"                Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps"     Version="1.*" />

    <!-- RoR2 game assemblies (published to BepInEx NuGet feed, no local game needed) -->
    <PackageReference Include="RiskofThunder.RoR2BepInExPack" Version="1.*" />

    <!-- R2API modules -->
    <PackageReference Include="RiskofThunder.R2API.Core"       Version="5.*" />
    <PackageReference Include="RiskofThunder.R2API.Prefab"     Version="1.*" />
    <PackageReference Include="RiskofThunder.R2API.Language"   Version="1.*" />
    <PackageReference Include="RiskofThunder.R2API.Sound"      Version="1.*" />
    <PackageReference Include="RiskofThunder.R2API.Loadout"    Version="1.*" />
    <PackageReference Include="RiskofThunder.R2API.DamageType" Version="1.*" />
    <PackageReference Include="RiskofThunder.R2API.ContentManagement" Version="1.*" />
  </ItemGroup>

</Project>
